rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'evoljaat@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidSiteConfig(data) {
      let allowed = [
        'titleHindi', 'subtitleHindi', 'locationHindi', 'sinceYear', 'taglineHindi',
        'aboutTitle', 'aboutDescription', 'heroImageUrl', 'aboutImageUrl',
        'channelBannerUrl', 'logoImageUrl', 'phoneDisplay', 'whatsappNumber',
        'youtubeChannelUrl', 'youtubeHandle', 'youtubeSubscriberText',
        'facebookPageUrl', 'instagramUrl', 'liveVideoUrl', 'liveVideoTitle',
        'isLiveNow', 'suvicharText', 'suvicharAuthor', 'bookingNoticeText',
        'ashramAddress', 'updatedAt'
      ];
      return data.keys().hasAll(allowed) &&
        data.keys().hasOnly(allowed) &&
        data.titleHindi is string && data.titleHindi.size() >= 2 && data.titleHindi.size() <= 120 &&
        data.subtitleHindi is string && data.subtitleHindi.size() <= 160 &&
        data.locationHindi is string && data.locationHindi.size() <= 120 &&
        data.sinceYear is string && data.sinceYear.size() <= 20 &&
        data.taglineHindi is string && data.taglineHindi.size() <= 240 &&
        data.aboutTitle is string && data.aboutTitle.size() <= 160 &&
        data.aboutDescription is string && data.aboutDescription.size() <= 2000 &&
        data.heroImageUrl is string && data.heroImageUrl.size() <= 1000 &&
        data.aboutImageUrl is string && data.aboutImageUrl.size() <= 1000 &&
        data.channelBannerUrl is string && data.channelBannerUrl.size() <= 1000 &&
        data.logoImageUrl is string && data.logoImageUrl.size() <= 1000 &&
        data.phoneDisplay is string && data.phoneDisplay.size() <= 30 &&
        data.whatsappNumber is string && data.whatsappNumber.size() >= 10 && data.whatsappNumber.size() <= 20 &&
        data.whatsappNumber.matches('^[0-9]{10,15}$') &&
        data.youtubeChannelUrl is string && data.youtubeChannelUrl.size() <= 500 &&
        data.youtubeHandle is string && data.youtubeHandle.size() <= 80 &&
        data.youtubeSubscriberText is string && data.youtubeSubscriberText.size() <= 60 &&
        data.facebookPageUrl is string && data.facebookPageUrl.size() <= 500 &&
        data.instagramUrl is string && data.instagramUrl.size() <= 500 &&
        data.liveVideoUrl is string && data.liveVideoUrl.size() <= 500 &&
        data.liveVideoTitle is string && data.liveVideoTitle.size() <= 200 &&
        data.isLiveNow is bool &&
        data.suvicharText is string && data.suvicharText.size() <= 600 &&
        data.suvicharAuthor is string && data.suvicharAuthor.size() <= 100 &&
        data.bookingNoticeText is string && data.bookingNoticeText.size() <= 600 &&
        data.ashramAddress is string && data.ashramAddress.size() <= 300 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidKatha(data) {
      let allowed = [
        'kathaName', 'dateRange', 'startDate', 'timing', 'cityState',
        'venue', 'organizer', 'status', 'posterUrl', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(allowed) &&
        data.keys().hasOnly(allowed) &&
        data.kathaName is string && data.kathaName.size() >= 2 && data.kathaName.size() <= 140 &&
        data.dateRange is string && data.dateRange.size() >= 2 && data.dateRange.size() <= 100 &&
        data.startDate is string && data.startDate.size() <= 20 && data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.timing is string && data.timing.size() <= 100 &&
        data.cityState is string && data.cityState.size() >= 2 && data.cityState.size() <= 140 &&
        data.venue is string && data.venue.size() <= 200 &&
        data.organizer is string && data.organizer.size() <= 140 &&
        data.status in ['upcoming', 'live', 'completed'] &&
        data.posterUrl is string && data.posterUrl.size() <= 1000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidKathaType(data) {
      let allowed = ['title', 'englishTitle', 'durationBadge', 'description', 'imageUrl', 'order', 'updatedAt'];
      return data.keys().hasAll(allowed) &&
        data.keys().hasOnly(allowed) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.englishTitle is string && data.englishTitle.size() <= 120 &&
        data.durationBadge is string && data.durationBadge.size() >= 1 && data.durationBadge.size() <= 60 &&
        data.description is string && data.description.size() <= 500 &&
        data.imageUrl is string && data.imageUrl.size() <= 1000 &&
        data.order is number && data.order >= 0 && data.order <= 100 &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidShort(data) {
      let allowed = ['title', 'youtubeUrl', 'thumbnailUrl', 'category', 'order', 'createdAt'];
      return data.keys().hasAll(allowed) &&
        data.keys().hasOnly(allowed) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.youtubeUrl is string && data.youtubeUrl.size() >= 5 && data.youtubeUrl.size() <= 500 &&
        data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000 &&
        data.category in ['भजन', 'प्रसंग', 'आरती', 'कथा अंश'] &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        data.createdAt is timestamp;
    }

    function isValidGalleryPhoto(data) {
      let allowed = ['title', 'location', 'imageUrl', 'order', 'createdAt'];
      return data.keys().hasAll(allowed) &&
        data.keys().hasOnly(allowed) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 160 &&
        data.location is string && data.location.size() <= 140 &&
        data.imageUrl is string && data.imageUrl.size() >= 1 && data.imageUrl.size() <= 1000 &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        data.createdAt is timestamp;
    }

    function isValidBooking(data) {
      let allowed = [
        'yajmanName', 'phone', 'cityState', 'kathaType', 'durationDays',
        'customDays', 'preferredDate', 'bookingType', 'message',
        'status', 'adminNotes', 'createdAt', 'updatedAt'
      ];
      return data.keys().hasAll(allowed) &&
        data.keys().hasOnly(allowed) &&
        data.yajmanName is string && data.yajmanName.size() >= 2 && data.yajmanName.size() <= 120 &&
        data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 20 &&
        data.phone.matches('^[+0-9\\s-]{8,20}$') &&
        data.cityState is string && data.cityState.size() >= 2 && data.cityState.size() <= 200 &&
        data.kathaType is string && data.kathaType.size() >= 2 && data.kathaType.size() <= 120 &&
        data.durationDays is string && data.durationDays.size() >= 1 && data.durationDays.size() <= 40 &&
        data.customDays is string && data.customDays.size() <= 40 &&
        data.preferredDate is string && data.preferredDate.size() <= 80 &&
        data.bookingType in ['normal', 'urgent'] &&
        data.message is string && data.message.size() <= 1000 &&
        data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
        data.adminNotes is string && data.adminNotes.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isValidAdminUser(data) {
      let allowed = ['email', 'displayName', 'role', 'createdAt'];
      return data.keys().hasAll(allowed) &&
        data.keys().hasOnly(allowed) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    // --- Collection Rules ---

    // Connection test document for startup verification
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // Site Config (Public Read, Admin Write)
    match /site_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if false;
      allow create: if isValidId(configId) && isAdmin() && isValidSiteConfig(incoming());
      allow update: if isValidId(configId) && isAdmin() && isValidSiteConfig(incoming());
      allow delete: if false;
    }

    // Upcoming Kathas (Public Read, Admin Full CRUD)
    match /kathas/{kathaId} {
      allow get: if isValidId(kathaId);
      allow list: if true;
      allow create: if isValidId(kathaId) && isAdmin() && isValidKatha(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(kathaId) && isAdmin() && isValidKatha(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(kathaId) && isAdmin();
    }

    // Katha Types (Public Read, Admin Full CRUD)
    match /katha_types/{typeId} {
      allow get: if isValidId(typeId);
      allow list: if true;
      allow create: if isValidId(typeId) && isAdmin() && isValidKathaType(incoming());
      allow update: if isValidId(typeId) && isAdmin() && isValidKathaType(incoming());
      allow delete: if isValidId(typeId) && isAdmin();
    }

    // Shorts & Bhajans (Public Read, Admin Full CRUD)
    match /shorts/{shortId} {
      allow get: if isValidId(shortId);
      allow list: if true;
      allow create: if isValidId(shortId) && isAdmin() && isValidShort(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(shortId) && isAdmin() && isValidShort(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(shortId) && isAdmin();
    }

    // Gallery Photos (Public Read, Admin Full CRUD)
    match /gallery/{photoId} {
      allow get: if isValidId(photoId);
      allow list: if true;
      allow create: if isValidId(photoId) && isAdmin() && isValidGalleryPhoto(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(photoId) && isAdmin() && isValidGalleryPhoto(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(photoId) && isAdmin();
    }

    // Katha Bookings (PII Isolated: Public Create with pending state; Admin-only Get/List/Update/Delete)
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().status == 'pending' &&
        incoming().adminNotes == '' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(bookingId) &&
        isAdmin() &&
        isValidBooking(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNotes', 'updatedAt']);
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // Admins Registry
    match /admins/{uid} {
      allow get: if isValidId(uid) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(uid) && isAdmin() && isValidAdminUser(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(uid) && isAdmin() && isValidAdminUser(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(uid) && isAdmin() && uid != request.auth.uid;
    }
  }
}
